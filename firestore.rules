rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // AUTH HELPERS
    // -----------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      let userRef = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userRef) ? get(userRef).data : null;
    }

    function hasRole(role) {
      let data = getUserData();
      return isSignedIn() && data != null && data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isSpecialist() {
      let data = getUserData();
      return isSignedIn() && data != null && (data.role == 'writer' || data.role == 'proofreader');
    }

    // Check if the specialist has passed verification through trusted server/admin approval
    function isVerifiedSpecialist() {
      let data = getUserData();
      return isSpecialist() && 
        data.verificationStatus == 'approved' && 
        data.writerStatus == 'active' && 
        data.isVerifiedWriter == true;
    }

    function isParticipant() {
      return
        resource.data.customerId == request.auth.uid ||
        resource.data.writerId   == request.auth.uid ||
        resource.data.proofreaderId == request.auth.uid;
    }

    // Fields that NO non-admin client may supply on creation or touch on update
    function protectedUserFinancialAndMetricFields() {
      return [
        'availableBalance',
        'reservedBalance',
        'totalEarned',
        'totalPaidOut',
        'pendingBalance',
        'payoutStatus',
        'wallet',
        'balances',
        'financials',
        'writerCommission',
        'proofreaderCommission',
        'databoyCommission',
        'pricingBreakdown',
        'reputation',
        'completedCount',
        'completedAssignments',
        'isVerifiedWriter',
        'writerStatus',
        'canProofread',
        'specialistCapabilities',
        'verifiedAt',
        'rejectedAt',
        'rejectionReason',
        'statusHistory',
        'disputeCount',
        'revisionCount',
        'activeTaskCount',
        'averageRating',
        'suspendedReason',
        'suspendedAt',
        'writingRating',
        'proofreadingRating',
        'overallRating',
        'writingCompletedTasks',
        'proofreadingCompletedTasks',
        'writingOnTimeRate',
        'proofreadingOnTimeRate',
        'writingRejectionRate',
        'proofreadingRejectionRate',
        'verifiedComplaintCount',
        'performanceReviewStatus',
        'allocationPreference',
        'ratingHistory',
        'performanceNotes',
        'lastPerformanceReviewDate'
      ];
    }

    // -----------------------------------------------------------------------
    // USERS COLLECTION (Phase 2 / Hardened Phase 5.8)
    // -----------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();

      // Self-registration:
      // 1. Must be the owning user (isOwner).
      // 2. Role MUST be 'customer' (or omitted). Users can NEVER self-assign 'admin', 'writer', or 'proofreader'.
      // 3. Status must be 'active' (or omitted).
      // 4. Must NOT supply protected financial balances, metrics, commissions, or verification outcome fields on creation.
      allow create: if isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'customer') &&
        (!('status' in request.resource.data) || request.resource.data.status == 'active') &&
        !request.resource.data.keys().hasAny(protectedUserFinancialAndMetricFields()) &&
        (!('verificationStatus' in request.resource.data) ||
          request.resource.data.verificationStatus in ['draft', 'incomplete', 'pending_review']);

      // Profile updates by the owning user:
      // 1. Role and account status CANNOT be modified by the user.
      // 2. Protected financial balances, metrics, commissions, and verification approval fields CANNOT be created, modified, or deleted (blocks top-level, merge, and nested map/dot-notation writes).
      // 3. verificationStatus: user cannot set 'approved' or alter an already approved status.
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status']) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFinancialAndMetricFields()) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus']) ||
          (request.resource.data.verificationStatus in ['draft', 'incomplete', 'pending_review', 'clarification_required', 'rejected'] &&
           (!('verificationStatus' in resource.data) || resource.data.verificationStatus != 'approved')))
      );

      // Only administrators (or Admin SDK) can assign roles, approve verifications, update metrics, or suspend accounts
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // ASSIGNMENTS COLLECTION (Phase 3 & Phase 6)
    // -----------------------------------------------------------------------
    match /assignments/{assignmentId} {

      allow get: if isSignedIn() && (
        isParticipant() ||
        resource.data.status == 'unassigned' ||
        (resource.data.status == 'draft_submitted' && isSpecialist()) ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        isAdmin() ||
        isParticipant() ||
        (resource.data.status == 'unassigned'      && isSpecialist()) ||
        (resource.data.status == 'draft_submitted' && isSpecialist())
      );

      // Create: strictly server-side only (Express API using Admin SDK computes pricing & ownership)
      allow create: if false;

      // Update: Strict field-level access control (Phase 3 & Phase 6 & Phase 5.14)
      // The following sensitive fields are NEVER directly updatable by ordinary clients:
      // status, payoutStatus, escrowStatus, paymentStatus, fundedAt, releasedAt, refundedAt,
      // budget, currency, pricingBreakdown, writerCommission, proofreaderCommission,
      // databoyCommission, customerId, writerId, proofreaderId, allocationStatus,
      // allocationAttempts, currentOfferWriterId, offerExpiresAt, source, pricingSource,
      // paymentReference, activeDisputeId, allocationMode, candidateWriterId.
      //
      // Permitted ordinary participant updates:
      // - Customer: can update permitted non-financial metadata only while unassigned/awaiting_payment.
      // - Assigned Writer: can update files while working (assigned, in_progress, review_rejected).
      // - Assigned Proofreader: can update files while reviewing (under_review).
      // Separation of Duties (Phase 6): Proofreader MUST NOT be the assigned writer!
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          isParticipant() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'status', 'payoutStatus', 'escrowStatus', 'paymentStatus', 'fundedAt', 'releasedAt', 'refundedAt',
            'budget', 'currency', 'pricingBreakdown', 'writerCommission', 'proofreaderCommission', 'databoyCommission',
            'customerId', 'writerId', 'proofreaderId', 'allocationStatus', 'allocationAttempts',
            'currentOfferWriterId', 'offerExpiresAt', 'source', 'pricingSource', 'paymentReference',
            'activeDisputeId', 'allocationMode', 'candidateWriterId'
          ]) &&
          (
            // Customer editing non-financial details prior to writer claim
            (resource.data.customerId == request.auth.uid &&
             resource.data.status in ['awaiting_payment', 'unassigned'] &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'title', 'guidelines', 'specialInstructions', 'files', 'deadline', 'pageCount',
               'wordCount', 'referencingStyle', 'projectType', 'academicLevel', 'subject',
               'customerUniversity', 'customerMajor', 'updatedAt'
             ])) ||
            // Writer uploading work in progress
            (resource.data.writerId == request.auth.uid &&
             resource.data.status in ['assigned', 'in_progress', 'review_rejected'] &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['files', 'writerNotes', 'updatedAt'])) ||
            // Proofreader uploading reviewed files or review notes (Assigned writer cannot review own work!)
            (resource.data.proofreaderId == request.auth.uid &&
             request.auth.uid != resource.data.writerId &&
             resource.data.status == 'under_review' &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['files', 'proofreaderNotes', 'proofreaderReview', 'updatedAt']))
          )
        )
      );

      allow delete: if isAdmin();

      // Activity subcollection (Created strictly via verified Express API / Admin SDK)
      match /activity/{activityId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/assignments/$(assignmentId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/assignments/$(assignmentId)).data.writerId == request.auth.uid ||
          get(/databases/$(database)/documents/assignments/$(assignmentId)).data.proofreaderId == request.auth.uid ||
          isAdmin()
        );
        allow create: if false;
        allow update, delete: if isAdmin();
      }
    }

    // -----------------------------------------------------------------------
    // OCR JOBS COLLECTION
    // -----------------------------------------------------------------------
    match /ocrJobs/{jobId} {
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
    }

    // -----------------------------------------------------------------------
    // RESEARCH REQUESTS COLLECTION (Phase 4)
    // -----------------------------------------------------------------------
    match /researchRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.assignedWriterId == request.auth.uid ||
        isAdmin()
      );

      // Create: strictly server-side only (Express API / Admin SDK)
      allow create: if false;

      // Students & Writers can only update non-privileged attachment/metadata fields
      // Modifying quoteAmount, quoteStatus, paymentStatus, escrowStatus, payoutStatus, status,
      // clarifications, or assignedWriterId is strictly forbidden to clients
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          (resource.data.studentId == request.auth.uid || resource.data.assignedWriterId == request.auth.uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'quoteAmount', 'quoteNotes', 'quoteStatus', 'paymentStatus', 'escrowStatus', 'payoutStatus',
            'fundedAt', 'status', 'clarifications', 'assignedWriterId', 'adminReviewedBy', 'studentId', 'createdAt'
          ])
        )
      );

      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // DISPUTES COLLECTION (Created & updated strictly via Express API / Admin SDK)
    // -----------------------------------------------------------------------
    match /disputes/{disputeId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.raisedBy == request.auth.uid ||
        resource.data.writerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // REFUND EXTERNAL REFERENCE UNIQUENESS LOCKS (Backend-only)
    // -----------------------------------------------------------------------
    match /refundExternalRefs/{refId} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // AUDIT LOGS COLLECTION
    // Audit logs are strictly immutable and writable only by backend Admin SDK
    // -----------------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // NOTIFICATIONS COLLECTION (Stage D — Notification Security)
    // Clients cannot inject arbitrary notifications for other users.
    // Notifications are created exclusively by backend Admin SDK.
    // Recipients may only read their own alerts and update the 'read' flag.
    // -----------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if false;
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }

    // -----------------------------------------------------------------------
    // FILE OBJECTS COLLECTION (Phase 5.17 — Cloudflare R2 Private Metadata)
    // All upload authorization, completion verification, deletion, and signed
    // download grants are governed exclusively by the Express backend API.
    // -----------------------------------------------------------------------
    match /fileObjects/{fileId} {
      allow read, write: if false;
    }
  }
}
