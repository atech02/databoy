rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // AUTH HELPERS
    // -----------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      let userRef = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userRef) ? get(userRef).data : null;
    }

    function hasRole(role) {
      let data = getUserData();
      return isSignedIn() && data != null && data.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isSpecialist() {
      let data = getUserData();
      return isSignedIn() && data != null && (data.role == 'writer' || data.role == 'proofreader');
    }

    // Check if the specialist has passed verification through trusted server/admin approval
    function isVerifiedSpecialist() {
      let data = getUserData();
      return isSpecialist() && 
        data.verificationStatus == 'approved' && 
        data.writerStatus == 'active' && 
        data.isVerifiedWriter == true;
    }

    function isParticipant() {
      return
        resource.data.customerId == request.auth.uid ||
        resource.data.writerId   == request.auth.uid ||
        resource.data.proofreaderId == request.auth.uid;
    }

    // -----------------------------------------------------------------------
    // USERS COLLECTION (Phase 2)
    // -----------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();

      // Self-registration:
      // 1. Must be the owning user (isOwner).
      // 2. Role MUST be 'customer' (or omitted, which defaults to customer). Users can NEVER self-assign 'admin', 'writer', or 'proofreader'.
      // 3. Status must be 'active'.
      // 4. Must NOT supply protected metrics or verification outcome fields on creation.
      allow create: if isOwner(userId) &&
        (!request.resource.data.keys().hasAll(['role']) || request.resource.data.role == 'customer') &&
        (!request.resource.data.keys().hasAll(['status']) || request.resource.data.status == 'active') &&
        (!request.resource.data.keys().hasAny(['reputation', 'completedCount', 'isVerifiedWriter', 'writerStatus'])) &&
        (!request.resource.data.keys().hasAny(['verificationStatus']) ||
          request.resource.data.verificationStatus in ['draft', 'incomplete', 'pending_review']);

      // Profile updates by the owning user:
      // 1. Role CANNOT be modified by the user under any circumstance.
      // 2. Status (active/suspended) cannot be changed.
      // 3. Protected admin/metric fields (reputation, completedCount, isVerifiedWriter, writerStatus) cannot be changed.
      // 4. verificationStatus: user cannot set 'approved' or alter an already approved status.
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'reputation', 'completedCount', 'isVerifiedWriter', 'writerStatus']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus']) ||
          (request.resource.data.verificationStatus in ['draft', 'incomplete', 'pending_review', 'clarification_required', 'rejected'] &&
           resource.data.verificationStatus != 'approved'))
      );

      // Only administrators (or Admin SDK / Cloud Functions) can assign roles, approve verifications, update metrics, or suspend accounts
      allow write: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // ASSIGNMENTS COLLECTION (Phase 3 & Phase 6)
    // -----------------------------------------------------------------------
    match /assignments/{assignmentId} {

      allow get: if isSignedIn() && (
        isParticipant() ||
        resource.data.status == 'unassigned' ||
        (resource.data.status == 'draft_submitted' && isSpecialist()) ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        isAdmin() ||
        isParticipant() ||
        (resource.data.status == 'unassigned'      && isSpecialist()) ||
        (resource.data.status == 'draft_submitted' && isSpecialist())
      );

      // Create: only customer or admin can open new assignment in draft/priced state with pending payout
      allow create: if isSignedIn() && (
        hasRole('customer') || isAdmin()
      ) && request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status in ['draft', 'priced'] &&
        (!request.resource.data.keys().hasAll(['payoutStatus']) || request.resource.data.payoutStatus == 'pending') &&
        (!request.resource.data.keys().hasAll(['writerId']) || request.resource.data.writerId == null) &&
        (!request.resource.data.keys().hasAll(['proofreaderId']) || request.resource.data.proofreaderId == null);

      // Update: Strict field-level access control (Phase 3 & Phase 6)
      // The following sensitive fields are NEVER directly updatable by ordinary clients:
      // status, payoutStatus, escrowStatus, paymentStatus, fundedAt, releasedAt, refundedAt,
      // budget, currency, pricingBreakdown, writerCommission, proofreaderCommission,
      // databoyCommission, customerId, writerId, proofreaderId, allocationStatus,
      // allocationAttempts, currentOfferWriterId, offerExpiresAt.
      //
      // Permitted ordinary participant updates:
      // - Customer: can update content fields only while in editable states (draft, priced, unassigned).
      // - Assigned Writer: can update files while working (assigned, in_progress, review_rejected).
      // - Assigned Proofreader: can update files while reviewing (under_review).
      // Separation of Duties (Phase 6): Proofreader MUST NOT be the assigned writer!
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          isParticipant() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'status', 'payoutStatus', 'escrowStatus', 'paymentStatus', 'fundedAt', 'releasedAt', 'refundedAt',
            'budget', 'currency', 'pricingBreakdown', 'writerCommission', 'proofreaderCommission', 'databoyCommission',
            'customerId', 'writerId', 'proofreaderId', 'allocationStatus', 'allocationAttempts', 'currentOfferWriterId', 'offerExpiresAt'
          ]) &&
          (
            // Customer editing draft/unassigned content details
            (resource.data.customerId == request.auth.uid &&
             resource.data.status in ['draft', 'priced', 'unassigned'] &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'title', 'guidelines', 'specialInstructions', 'files', 'deadline', 'pageCount',
               'wordCount', 'referencingStyle', 'projectType', 'academicLevel', 'subject',
               'customerUniversity', 'customerMajor', 'updatedAt'
             ])) ||
            // Writer uploading work in progress
            (resource.data.writerId == request.auth.uid &&
             resource.data.status in ['assigned', 'in_progress', 'review_rejected'] &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['files', 'writerNotes', 'updatedAt'])) ||
            // Proofreader uploading reviewed files or review notes (Assigned writer cannot review own work!)
            (resource.data.proofreaderId == request.auth.uid &&
             request.auth.uid != resource.data.writerId &&
             resource.data.status == 'under_review' &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['files', 'proofreaderNotes', 'proofreaderReview', 'updatedAt']))
          )
        )
      );

      allow delete: if isAdmin();

      // Activity subcollection
      match /activity/{activityId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/assignments/$(assignmentId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/assignments/$(assignmentId)).data.writerId == request.auth.uid ||
          get(/databases/$(database)/documents/assignments/$(assignmentId)).data.proofreaderId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isSignedIn() && (
          get(/databases/$(database)/documents/assignments/$(assignmentId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/assignments/$(assignmentId)).data.writerId == request.auth.uid ||
          get(/databases/$(database)/documents/assignments/$(assignmentId)).data.proofreaderId == request.auth.uid ||
          isAdmin()
        ) && request.resource.data.actorId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // -----------------------------------------------------------------------
    // OCR JOBS COLLECTION
    // -----------------------------------------------------------------------
    match /ocrJobs/{jobId} {
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
    }

    // -----------------------------------------------------------------------
    // RESEARCH REQUESTS COLLECTION (Phase 4)
    // -----------------------------------------------------------------------
    match /researchRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.assignedWriterId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isSignedIn() && (
        hasRole('customer') || isAdmin()
      ) && request.resource.data.studentId == request.auth.uid &&
        (!request.resource.data.keys().hasAny(['quoteAmount', 'quoteStatus', 'assignedWriterId', 'adminReviewedBy'])) &&
        (request.resource.data.status in ['submitted', 'needs_clarification']);

      // Students & Writers can only update non-privileged fields (e.g. clarification threads, attachments)
      // Modifying quoteAmount, quoteStatus, paymentStatus, status, assignedWriterId is STRICTLY FORBIDDEN to clients
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          (resource.data.studentId == request.auth.uid || resource.data.assignedWriterId == request.auth.uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'quoteAmount', 'quoteNotes', 'quoteStatus', 'paymentStatus', 'status',
            'assignedWriterId', 'adminReviewedBy', 'studentId', 'createdAt'
          ])
        )
      );

      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // DISPUTES COLLECTION
    // -----------------------------------------------------------------------
    match /disputes/{disputeId} {
      allow read: if isSignedIn() && (
        resource.data.studentId == request.auth.uid ||
        resource.data.writerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.studentId == request.auth.uid ||
        request.resource.data.writerId == request.auth.uid ||
        isAdmin()
      ) && request.resource.data.status == 'open' &&
        (!request.resource.data.keys().hasAny(['resolution', 'adminNotes']));

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // -----------------------------------------------------------------------
    // AUDIT LOGS COLLECTION
    // -----------------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // NOTIFICATIONS COLLECTION
    // -----------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        (resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }
  }
}
